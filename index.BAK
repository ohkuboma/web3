                  <text x="580" y="15" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">;</text>
                  <text x="580" y="32" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">+</text>
                  
                  <rect x="610" y="0" width="40" height="40" fill="#ffccdd" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="630" y="15" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">:</text>
                  <text x="630" y="32" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">*</text>
                  
                  <rect x="660" y="0" width="40" height="40" fill="#ffccdd" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="680" y="15" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">]</text>
                  <text x="680" y="32" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">}</text>
                </g>
                
                <!-- 第4段 -->
                <g transform="translate(0, 200)">
                  <rect x="20" y="0" width="60" height="40" fill="#ffcccc" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="50" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">Shift</text>
                  
                  <rect x="90" y="0" width="40" height="40" fill="#ffcccc" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="110" y="22" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle">Z</text>
                  
                  <rect x="140" y="0" width="40" height="40" fill="#ffddcc" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="160" y="22" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle">X</text>
                  
                  <rect x="190" y="0" width="40" height="40" fill="#ffffcc" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="210" y="22" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle">C</text>
                  
                  <rect x="240" y="0" width="40" height="40" fill="#ccffcc" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="260" y="22" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle">V</text>
                  
                  <rect x="290" y="0" width="40" height="40" fill="#ccffcc" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="310" y="22" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle">B</text>
                  
                  <rect x="340" y="0" width="40" height="40" fill="#ccffff" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="360" y="22" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle">N</text>
                  
                  <rect x="390" y="0" width="40" height="40" fill="#ccffff" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="410" y="22" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle">M</text>
                  
                  <rect x="440" y="0" width="40" height="40" fill="#ccffff" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="460" y="15" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">,</text>
                  <text x="460" y="32" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">&lt;</text>
                  
                  <rect x="490" y="0" width="40" height="40" fill="#ddddff" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="510" y="15" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">.</text>
                  <text x="510" y="32" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">&gt;</text>
                  
                  <rect x="540" y="0" width="40" height="40" fill="#ffccff" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="560" y="15" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">/</text>
                  <text x="560" y="32" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">?</text>
                  
                  <rect x="590" y="0" width="40" height="40" fill="#ffccdd" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="610" y="15" font-family="Arial" font-size="18" font-weight="bold" text-anchor="middle" dominant-baseline="middle" fill="red">\_</text>
                  
                  <rect x="640" y="0" width="120" height="40" fill="#ffccdd" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="700" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">Shift</text>
                </g>
                
                <!-- 第5段 -->
                <g transform="translate(0, 250)">
                  <rect x="20" y="0" width="50" height="40" fill="#ffcccc" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="45" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">Ctrl</text>
                  
                  <rect x="80" y="0" width="50" height="40" fill="#ffcccc" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="105" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">Win</text>
                  
                  <rect x="140" y="0" width="50" height="40" fill="#ffcccc" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="165" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">Alt</text>
                  
                  <rect x="200" y="0" width="260" height="40" fill="#ccffff" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="330" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">スペース</text>
                  
                  <rect x="470" y="0" width="50" height="40" fill="#ffccdd" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="495" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">Alt</text>
                  
                  <rect x="530" y="0" width="50" height="40" fill="#ffccdd" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="555" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">Win</text>
                  
                  <rect x="590" y="0" width="50" height="40" fill="#ffccdd" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="615" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">Menu</text>
                  
                  <rect x="650" y="0" width="50" height="40" fill="#ffccdd" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="675" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">Ctrl</text>
                </g>
                
                <!-- 方向キー -->
                <g transform="translate(0, 300)">
                  <rect x="590" y="0" width="40" height="40" fill="white" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="610" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">←</text>
                  
                  <rect x="640" y="0" width="40" height="40" fill="white" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="660" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">↓</text>
                  
                  <rect x="690" y="0" width="40" height="40" fill="white" stroke="#999" stroke-width="1" rx="3" ry="3"/>
                  <text x="710" y="22" font-family="Arial" font-size="16" font-weight="bold" text-anchor="middle" dominant-baseline="middle">→</text>
                </g>
              </svg>
            

